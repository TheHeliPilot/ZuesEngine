// Helper to register a system with proper metadata for the Systems UI
template<typename T>
static void RegisterGameSystem(World* world, const std::string& name, System::SystemRole role, bool isRequired = false) {
    // Register in the system registry for UI/serialization
    world->GetSystemRegistry().RegisterSystem<T>(name, role, isRequired, true /* isFromDLL */);

    // Create and add the actual system instance
    auto system = std::make_unique<T>();
    system->systemName = name;
    system->role = role;
    system->isRequired = isRequired;
    world->RegisterSystem(std::move(system));
}

GAME_API_C void GameDLL_RegisterSystems(World* world) {
    std::cout << "[{{PROJECT_NAME}}] Registering systems\n";

    // ============================================================================
    // REGISTER YOUR CUSTOM SYSTEMS HERE
    // Use RegisterGameSystem helper for proper hot-reload and UI support
    // ============================================================================
    //
    // RegisterGameSystem<PlayerMovementSystem>(world, "PlayerMovement", System::SystemRole::Game);
    //
    // System roles:
    //   - Game: Only runs during play mode
    //   - Shared: Runs in both editor and play mode
    //   - Editor: Only runs in editor mode (not recommended for game DLL)
    //
    // isRequired: If true, the system cannot be disabled in the Systems UI
}

