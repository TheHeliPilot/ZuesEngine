// Helper to register a system with proper metadata for the Systems UI
template<typename T>
static void RegisterGameSystem(World* world, const std::string& name, System::SystemRole role, bool isRequired = false) {
    // Register in the system registry for UI/serialization
    world->GetSystemRegistry().RegisterSystem<T>(name, role, isRequired, true /* isFromDLL */);

    // Create and add the actual system instance
    auto system = std::make_unique<T>();
    system->systemName = name;
    system->role = role;
    system->isRequired = isRequired;
    world->RegisterSystem(std::move(system));
}

