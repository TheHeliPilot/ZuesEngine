      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ZUES_BUILD_EDITOR": "ON",
        "ZUES_BUILD_LAUNCHER": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (VS)",
